{
    "builds": [{
        "src": "nkowebe/wsgi.py",
        "use": "@vercel/python",
        "config": { "maxLambdaSize": "50mb", "runtime": "python3.9" }
    }],
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "/staticfiles/$1"
          },
        {
            "src": "/(.*)",
            "dest": "nkowebe/wsgi.py"
        }
    ],

  "buildCommand": "python manage.py collectstatic --noinput"
}