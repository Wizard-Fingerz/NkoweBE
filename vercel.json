{
    "builds": [{
        "src": "nkowebe/wsgi.py",
        "use": "@vercel/python",
        "config": { "maxLambdaSize": "50mb", "runtime": "python3.9", "outputDirectory": "staticfiles" }
    }],
    "routes": [
       
        {
            "src": "/(.*)",
            "dest": "nkowebe/wsgi.py"
        }
    ],

  "buildCommand": "python manage.py collectstatic --noinput"
}